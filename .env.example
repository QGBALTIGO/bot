# Telegram
BOT_TOKEN=replace-with-botfather-token
BOT_OWNER_ID=123456789

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/source_baltigo

# HTTP / logging
PORT=8000
LOG_LEVEL=INFO

# Terms and required channel
TERMS_VERSION=v1
REQUIRED_CHANNEL=@SourceBaltigo
REQUIRED_CHANNEL_URL=https://t.me/SourceBaltigo

# AniNexus news -> Telegram channel
ANINEXUS_NEWS_ENABLED=true
ANINEXUS_NEWS_API_URL=https://aninexus.com.br/api/news
ANINEXUS_NEWS_SITE_URL=https://aninexus.com.br
ANINEXUS_NEWS_CHANNEL=@AniNexus_Oficial
ANINEXUS_NEWS_INTERVAL_SECONDS=60
ANINEXUS_NEWS_FETCH_LIMIT=60
ANINEXUS_NEWS_MAX_PER_CYCLE=5
# false registra as notícias atuais sem publicá-las; só as próximas serão enviadas
ANINEXUS_NEWS_SEND_EXISTING=false
ANINEXUS_NEWS_FALLBACK_IMAGE_URL=https://aninexus.com.br/assets/logo-512.png

# Numeric Telegram user IDs separated by commas
ADMINS=123456789
ADMIN_IDS=123456789
CARD_ADMIN_IDS=123456789

# Legacy compatibility only; numeric IDs are safer
CARD_ADMIN_USERNAMES=

# Telegram MiniApp authentication
WEBAPP_INITDATA_MAX_AGE_SECONDS=21600
WEBAPP_INITDATA_FUTURE_SKEW_SECONDS=120
# Opcional: ID numérico do bot, útil quando bot e WebApp usam serviços separados.
# Normalmente ele é inferido automaticamente da parte antes de ':' em BOT_TOKEN.
TELEGRAM_WEBAPP_BOT_ID=
# production ou test; mantenha production no bot real.
TELEGRAM_WEBAPP_ENV=production

# Source Health / alerts
SOURCE_HEALTH_ALERTS_ENABLED=true
# Opcional. Se vazio, BOT_OWNER_ID é usado como destino dos alertas.
SOURCE_ALERT_CHAT_ID=
SOURCE_HEALTH_INTERVAL_SECONDS=120
# Quantas verificações consecutivas devem falhar antes do alerta.
SOURCE_HEALTH_FAILURE_THRESHOLD=2

# Runtime protection
GATEKEEPER_RATE_LIMIT=8
GATEKEEPER_RATE_WINDOW_SECONDS=5
PROGRESS_RATE_LIMIT=1
PROGRESS_RATE_WINDOW_SECONDS=2.5
RATE_LIMITER_MAX_KEYS=50000
RATE_LIMITER_CLEANUP_SECONDS=60
LOCK_MANAGER_MAX_KEYS=20000
LOCK_MANAGER_IDLE_SECONDS=300
WORKER_RESTART_MAX_SECONDS=30

# Optional visual assets
TOP_BANNER_URL=
BACKGROUND_URL=
