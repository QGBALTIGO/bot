# Required
BOT_TOKEN=
DATABASE_URL=postgresql://user:password@host:5432/database
BASE_URL=https://your-public-domain.example

# Runtime
PORT=8000
LOG_LEVEL=INFO
BOT_USERNAME=SourceBaltigo_Bot

# Access / onboarding
TERMS_VERSION=v1
REQUIRED_CHANNEL=@SourceBaltigo
REQUIRED_CHANNEL_URL=https://t.me/SourceBaltigo
QG_URL=https://t.me/QG_BALTIGO

# Mini App security
# Generate a long random value and send it only as X-Admin-Token when an
# administrative HTTP endpoint really needs to be called.
WEBAPP_ADMIN_TOKEN=
WEBAPP_AUTH_MAX_AGE_SECONDS=3600

# Cards administration
CARD_ADMIN_IDS=
CARD_ADMIN_USERNAMES=
ADMIN_RATE_LIMIT=12
ADMIN_RATE_WINDOW_SECONDS=10

# Abuse protection
GATEKEEPER_RATE_LIMIT=8
GATEKEEPER_RATE_WINDOW_SECONDS=5
PROGRESS_RATE_LIMIT=1
PROGRESS_RATE_WINDOW_SECONDS=2.5
CARD_CALLBACK_RATE_LIMIT=4
CARD_CALLBACK_RATE_WINDOW_SECONDS=3

# Catalog paths
CATALOG_PATH=data/catalogo_enriquecido.json
CARDS_ASSETS_PATH=data/personagens_anilist.txt
CARDS_OVERRIDES_PATH=data/cards_overrides.json

# Optional visual assets
TERMS_BANNER_URL=
WELCOME_BANNER_URL=
CARDS_BANNER_URL=
BALTIGOFLIX_BANNER_URL=

# Experimental / incomplete subsystem.
# Keep false until the missing persistence layer for messages is rebuilt.
ENABLE_MESSAGES=false
MESSAGE_RELAY_CHANNEL_ID=
MSG_ANON_COST=3
MSG_COOLDOWN_NORMAL_SECONDS=30
MSG_COOLDOWN_ANON_SECONDS=90
