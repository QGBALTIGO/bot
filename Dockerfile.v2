FROM oven/bun:1.3.14 AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package.json frontend/bun.lock ./
RUN bun install --frozen-lockfile
COPY frontend/ ./
ENV VITE_BASE_PATH=/v2/
RUN bun run type-check && bun run build


FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SOURCE_V2_STATIC_DIR=/app/webapp_v2_static

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY . .
COPY --from=frontend-builder /app/frontend/dist /app/webapp_v2_static

CMD ["sh", "-c", "uvicorn webapp_entrypoint:app --host 0.0.0.0 --port ${PORT:-8000}"]
